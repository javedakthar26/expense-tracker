generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Transaction {
  id          String   @id @default(cuid())
  type        String // "INCOME" | "EXPENSE"
  amount      Float
  category    String
  description String?
  paymentMode String // "CASH" | "CARD" | "UPI" | "BANK" | "WALLET"
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([type])
  @@index([category])
}

model Budget {
  id        String   @id @default(cuid())
  category  String
  amount    Float
  month     String // "YYYY-MM"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, month])
}
